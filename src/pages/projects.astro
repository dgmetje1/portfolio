---
import ProjectsApp from '../components/ProjectsPortfolio';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const title = 'Projects - Dani Garcia Metje';
const description = 'Explore my personal projects and open source contributions. Under construction - more projects coming soon!';
const siteUrl = 'https://dgmetje.dev';
const ogImage = `${siteUrl}${base}og-image.png`;
const twitterHandle = '@dgmetje';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/x-icon" href={`${base}/favicon.ico`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
		<link rel="icon" type="image/png" sizes="48x48" href={`${base}/favicon-48x48.png`} />
		<link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96x96.png`} />
		<link rel="icon" type="image/png" sizes="128x128" href={`${base}/apple-touch-icon.png`} />
		<link rel="icon" type="image/png" sizes="192x192" href={`${base}/android-chrome-192x192.png`} />
		<link rel="icon" type="image/png" sizes="512x512" href={`${base}/android-chrome-512x512.png`} />
		<link rel="manifest" href={`${base}/site.webmanifest`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#1e293b" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={`${siteUrl}/projects`} />
		<link rel="alternate" hreflang="en" href={`${siteUrl}/en/projects/`} />
		<link rel="alternate" hreflang="es" href={`${siteUrl}/es/projects/`} />
		<link rel="alternate" hreflang="ca" href={`${siteUrl}/ca/projects/`} />
		<link rel="alternate" hreflang="fr" href={`${siteUrl}/fr/projects/`} />
		<link rel="alternate" hreflang="x-default" href={`${siteUrl}/projects`} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={`${siteUrl}/projects`} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${siteUrl}${base}og-image.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Dani Garcia Metje - Projects Preview" />
		<meta property="og:site_name" content="Dani Garcia Metje Portfolio" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:locale:alternate" content="es_ES" />
		<meta property="og:locale:alternate" content="ca_ES" />
		<meta property="og:locale:alternate" content="fr_FR" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={`${siteUrl}/projects`} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={`${siteUrl}${base}og-image.png`} />
		<meta name="twitter:image:alt" content="Dani Garcia Metje - Projects Preview" />
		<meta name="twitter:site" content={twitterHandle} />
		<meta name="twitter:creator" content={twitterHandle} />

		<!-- Additional SEO -->
		<meta name="author" content="Dani Garcia Metje" />
		<meta name="keywords" content="Frontend Developer, React, TypeScript, Astro, Portfolio, Projects, Open Source, Web Development" />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "CollectionPage",
			"name": "Projects",
			"description": description,
			"url": `${siteUrl}/projects`,
			"mainEntity": {
				"@type": "ItemList",
				"name": "Personal Projects",
				"description": "Collection of personal and open source projects"
			}
		}, null, 2)} />

		<title>{title}</title>
	</head>
	<body class="m-0 p-0 overflow-x-hidden">
		<ProjectsApp client:visible />
	</body>
</html>