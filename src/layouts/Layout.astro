---
import '../styles/global.css';
import { getLocalizedPath, locales, withBase, defaultLang, type Lang, type Page } from '../i18n/config';

interface Props {
	lang: Lang;
	page: Page;
	title: string;
	description: string;
	keywords: string;
	ogImageAlt: string;
	jsonLd: Record<string, unknown>;
}

const { lang, page, title, description, keywords, ogImageAlt, jsonLd } = Astro.props;

const ogLocales: Record<Lang, string> = { en: 'en_US', ca: 'ca_ES', es: 'es_ES', fr: 'fr_FR' };
const absolute = (path: string) => new URL(path, Astro.site).href;

const canonicalUrl = absolute(getLocalizedPath(lang, page));
const ogImage = absolute(withBase('og-image.png'));
const twitterHandle = '@dgmetje';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<link rel="icon" type="image/x-icon" href={withBase('favicon.ico')} />
		<link rel="icon" type="image/png" sizes="16x16" href={withBase('favicon-16x16.png')} />
		<link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32x32.png')} />
		<link rel="icon" type="image/png" sizes="48x48" href={withBase('favicon-48x48.png')} />
		<link rel="icon" type="image/png" sizes="96x96" href={withBase('favicon-96x96.png')} />
		<link rel="icon" type="image/png" sizes="192x192" href={withBase('favicon-192x192.png')} />
		<link rel="icon" type="image/png" sizes="512x512" href={withBase('favicon-512x512.png')} />
		<link rel="apple-touch-icon" sizes="180x180" href={withBase('favicon-180x180.png')} />
		<link rel="manifest" href={withBase('site.webmanifest')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#1e293b" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		{locales.map(code => <link rel="alternate" hreflang={code} href={absolute(getLocalizedPath(code, page))} />)}
		<link rel="alternate" hreflang="x-default" href={absolute(getLocalizedPath(defaultLang, page))} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:site_name" content="Dani Garcia Metje Portfolio" />
		<meta property="og:locale" content={ogLocales[lang]} />
		{locales.filter(code => code !== lang).map(code => <meta property="og:locale:alternate" content={ogLocales[code]} />)}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<meta name="twitter:site" content={twitterHandle} />
		<meta name="twitter:creator" content={twitterHandle} />

		<!-- Additional SEO -->
		<meta name="author" content="Dani Garcia Metje" />
		<meta name="keywords" content={keywords} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', url: canonicalUrl, ...jsonLd })} />

		<title>{title}</title>
	</head>
	<body class="m-0 p-0 overflow-x-hidden">
		<slot />
	</body>
</html>
